<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Library access. READ_MEDIA_AUDIO on 33+, legacy read below that. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Optional and never requested at launch. The audio-reactive visualizer mode
      needs the platform Visualizer effect, which is gated behind RECORD_AUDIO.
      The default artwork-driven visualizer needs no permission at all.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".SpindleApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spindle">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Spindle">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              "Share to Spindle" from a browser, a file manager, or anything else
              holding an audio file. This is the shortest path from "I have the
              file" to "it is in my library and in a playlist".
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- "Open with Spindle" from a file manager or a download. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="audio/*" />
                <data android:scheme="file" android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!--
          Keeps Genius search and lyric pages inside Spindle, then applies a
          selectable reading view to song pages. It accepts no external intents.
        -->
        <activity
            android:name=".ui.lyrics.GeniusReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.Spindle" />

        <!--
          Exported on purpose: a media session is only reachable by Bluetooth
          remotes, Assistant and Android Auto if the service they bind to is
          exported. This is the configuration Media3 documents.
        -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <!--
                  MediaLibraryService extends MediaSessionService, and a
                  controller can resolve this component by either action. Both
                  are declared so nothing has to guess which one we are.
                -->
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <!--
          Serves cover art that lives inside the audio file, which MediaStore
          often does not extract. Not exported: a content URI is understood by
          Coil, the widget, the notification and Android Auto without any other
          app needing to reach it.
        -->
        <provider
            android:name=".data.media.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.LockScreenNowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/lock_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_screen_now_playing_widget_info" />
        </receiver>

    </application>
</manifest>
