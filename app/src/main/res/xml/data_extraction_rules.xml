<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Play counts, playlists and favourites are worth restoring to a new phone. -->
        <include domain="database" path="spindle.db" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="spindle.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
